{
        "reload_style_on_change": true,
        "layer": "top",
        "position": "top",
        "exclusive": true,
        "passthrough": false,
        "margin-top": 4,
        "margin-left": 4,
        "margin-right": 4,
        "spacing": 10,
        "modules-left": [
                "custom/launcher",
                "hyprland/workspaces",
                "hyprland/window"
        ],
        "modules-center": [
                "clock"
        ],
        "modules-right": [
                "network",
                "tray",
                "pulseaudio#mic",
                "pulseaudio",
                // "bluetooth",
                "power-profiles-daemon",
                "battery"
                // "group/power"
        ],
        "custom/launcher": {
                "format": " ",
                "tooltip": "Launcher",
                "on-click": "rofi -show drun"
        },
        "hyprland/workspaces": {
                "disable-scroll": true,
                "all-outputs": false,
                "active-only": false,
                "show-special": false,
                "format": "{name}"
        },
        "hyprland/window": {
                "format": "{}",
                "rewrite": {
                       "^(.+)$": "| $1"
                 },
                "separate-outputs": true,
                "max-length": 20
        },
        "pulseaudio": {
                "scroll-step": 2,
                "format": "{volume}% {icon}",
                "format-muted": "",
                "format-icons": {
                        "headphones": " ",
                        "headset": " ",
                        "handsfree": " ",
                        "phone": "",
                        "portable": "",
                        "car": "",
                        "default": [
                                "",
                                ""
                        ]
                },
                "on-click": "pavucontrol-qt"
        },
        "pulseaudio#mic": {
                "scroll-step": 0,
                "format": "{format_source}",
                "format-source": "",
                "format-source-muted": "",
                "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
        },
        "network": {
                "interval": 5,
                "format-wifi": "{essid} {signalStrength}%",
                "format-ethernet": "{ifname} ",
                "format-disconnected": "Disconnected ",
                "tooltip-format": "{ipaddr}/{cidr}",
                "on-click": "pgrep -x nm-connection-editor >/dev/null || nm-connection-editor"
        },
        "tray": {
                "show-passive-items": true,
                "icon-size": 18,
                "spacing": 8
        },
        // "bluetooth": {
        //         "interval": 10,
        //         "format": "",
        //         "on-click": "bash -lc 'command -v kcmshell6 >/dev/null && kcmshell6 kcm_bluetooth || bluedevil-wizard'",
        //         "on-click-right": "bluedevil-sendfile"
        // },
        "power-profiles-daemon": {
                "format": "{icon}",
                "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
                "tooltip": true,
                "format-icons": {
                        "default": " ",
                        "performance": " ",
                        "balanced": " ",
                        "power-saver": " "
                }
        },
        "battery": {
                "interval": 10,
                "states": {
                        "warning": 30,
                        "critical": 15
                },
                "format": "{capacity}% {icon}",
                "format-full": "{capacity}% {icon}",
                "format-charging": "{capacity}% ",
                "format-plugged": "{capacity}% ",
                "format-alt": "{time} {icon}",
                "format-icons": [
                        " ",
                        " ",
                        " ",
                        " ",
                        " "
                ]
        },
        "clock": {
                "interval": 30,
                "format": "{:%I:%M %p - %a %b %d }",
                //"format": "{:%I:%M %p - %B %d, %Y}",
                // "format": "{:%a %b %d  %H:%M}",
                "format-alt": "{:%Y-%m-%d}",
                "tooltip-format": "{:%Y-%m-%d}"
        },
        // "group/power": {
        //         "orientation": "inherit",
        //         "drawer": {
        //                 "transition-duration": 250,
        //                 "children-class": "power-hidden",
        //                 "transition-left-to-right": false
        //         },
        //         "modules": [
        //                 "custom/power",
        //                 "custom/lock",
        //                 "custom/reboot",
        //                 "custom/logout"
        //         ]
        // },
        // "custom/power": {
        //         "format": " ",
        //         "tooltip": "Power off",
        //         "on-click": "systemctl poweroff"
        // },
        // "custom/lock": {
        //         "format": "󰍁 ",
        //         "tooltip": "Lock",
        //         "on-click": "hyprlock"
        // },
        // "custom/reboot": {
        //         "format": "󰜉 ",
        //         "tooltip": "Reboot",
        //         "on-click": "systemctl reboot"
        // },
        // "custom/logout": {
        //         "format": "󰗼 ",
        //         "tooltip": "Exit Hyprland",
        //         "on-click": "hyprctl dispatch exit"
        // }
}

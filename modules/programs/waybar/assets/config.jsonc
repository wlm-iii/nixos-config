{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "spacing": 6,
  "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "network",
    "bluetooth",
    "pulseaudio#mic",
    "pulseaudio",
    "power-profiles-daemon",
    "group/tray",
    "battery"
    // "group/power"
  ],
  "custom/launcher": {
    "format": "",
    "tooltip": "Launcher",
    "on-click": "rofi -show drun"
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "active-only": false,
    "show-special": false,
    "format": "{name}"
  },
  "hyprland/window": {
    "format": "{}",
    "rewrite": {
      "^(.+)$": "| $1"
    },
    "separate-outputs": true,
    "max-length": 20
  },
  "pulseaudio": {
    "scroll-step": 2,
    // "format": "{volume}% {icon}",
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "headphones": "",
      "headset": "",
      "handsfree": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", ""]
    },
    "on-click": "pavucontrol-qt"
  },
  "pulseaudio#mic": {
    "scroll-step": 0,
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": "",
    "align": 0.5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
  },
  // "network": {
  //         "interval": 5,
  //         "format-wifi": "{essid} {signalStrength}%",
  //         "format-ethernet": "{ifname} ",
  //         "format-disconnected": "Disconnected ",
  //         "tooltip-format": "{ipaddr}/{cidr}",
  //         "on-click": "pgrep -x nm-connection-editor >/dev/null || nm-connection-editor"
  // },
  "network": {
    "interval": 5,
    "format-wifi": "{icon}",
    "format-ethernet": "",
    "format-disconnected": "󰤭",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip": true,
    "tooltip-format-wifi": "{essid} {signalStrength}%",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected ",
    // "on-click": "pgrep -x nm-connection-editor >/dev/null || nm-connection-editor"
    "on-click": "networkmanager_dmenu"
  },
  "custom/tray-toggle": {
    "format": "󱗼",
    "tooltip": true,
    "tooltip-format": "System Tray"
  },
  "group/tray": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": ["custom/tray-toggle", "tray"]
  },
  "tray": {
    "show-passive-items": true,
    "icon-size": 18,
    "spacing": 4
  },
  "bluetooth": {
    "format": "",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "align": 0.5,
    "tooltip": true,
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "rofi-bluetooth"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-full": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "{icon}",
    "format-alt": "{capacity}% {icon}",
    "tooltip": true,
    "tooltip-format": "{capacity}%, {timeTo}",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": [
        "󰢟",
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ]
    }
  },
  "clock": {
    "interval": 30,
    "format": "{:%I:%M %p - %a %b %d }",
    //"format": "{:%I:%M %p - %B %d, %Y}",
    // "format": "{:%a %b %d  %H:%M}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip-format": "{:%Y-%m-%d}"
  }
  // "group/power": {
  //         "orientation": "inherit",
  //         "drawer": {
  //                 "transition-duration": 250,
  //                 "children-class": "power-hidden",
  //                 "transition-left-to-right": false
  //         },
  //         "modules": [
  //                 "custom/power",
  //                 "custom/lock",
  //                 "custom/reboot",
  //                 "custom/logout"
  //         ]
  // },
  // "custom/power": {
  //         "format": " ",
  //         "tooltip": "Power off",
  //         "on-click": "systemctl poweroff"
  // },
  // "custom/lock": {
  //         "format": "󰍁 ",
  //         "tooltip": "Lock",
  //         "on-click": "hyprlock"
  // },
  // "custom/reboot": {
  //         "format": "󰜉 ",
  //         "tooltip": "Reboot",
  //         "on-click": "systemctl reboot"
  // },
  // "custom/logout": {
  //         "format": "󰗼 ",
  //         "tooltip": "Exit Hyprland",
  //         "on-click": "hyprctl dispatch exit"
  // }
}
